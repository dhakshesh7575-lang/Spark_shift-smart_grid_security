# WhatsApp Admin Configuration
# DO NOT put real numbers in .env.example or commit .env
# Numbers must be in E.164 format: +[country][number]

WHATSAPP_TEST_MODE=true
WHATSAPP_ADMIN_NUMBERS=
# e.g. +919000000000,+919000000001

# Server
PORT=3001
NODE_ENV=development

# WhatsApp Worker
WHATSAPP_WORKER_ID=whatsapp-worker-1
SELENIUM_HEADLESS=false
WHATSAPP_PROFILE_DIR=./worker/profile

# ---------------------------------------------------------------------------
# EB Admin SMS Alerts (ESP32 electricity-theft detection)
# ---------------------------------------------------------------------------
# ALERT_MODE: SIMULATION (default — free, no provider, nothing is sent) or
# REAL_SMS (requires an eligible FREE trial / free credits and valid creds).
ALERT_MODE=SIMULATION

# EB Admin mobile number in E.164 format (+[country][number]).
# Leave blank in shared/public configuration — never commit a real number.
ADMIN_PHONE_NUMBER=

# Base URL clients (ESP32) use to reach this backend.
BACKEND_URL=http://localhost:3001

# Device authentication. The ESP32 must send these as HTTP headers:
#   x-device-id:    <DEVICE_ID>
#   x-device-token: <DEVICE_TOKEN>
# Use long random values; never commit real credentials.
DEVICE_ID=
DEVICE_TOKEN=

# Optional real-SMS provider (ONLY used when ALERT_MODE=REAL_SMS and a
# provider offering eligible FREE credits has been explicitly configured).
#
# SMS_PROVIDER=none      → demo only, nothing is ever sent (default)
# SMS_PROVIDER=generic   → any JSON HTTP provider (SMS_PROVIDER_URL + KEY)
# SMS_PROVIDER=twilio    → Twilio REST API (account SID + auth token + from #)
SMS_PROVIDER=none
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=

# Twilio-style credentials (ONLY needed when SMS_PROVIDER=twilio).
# Use a FREE trial account / free credits. Never commit these values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional hardening for the dashboard/relay grid-alert route
# (POST /api/grid-alerts). Set to true to require x-device-id/x-device-token.
GRID_REQUIRE_DEVICE_AUTH=false

# Duplicate suppression + abuse protection.
ALERT_COOLDOWN_SECONDS=60
ALERT_RATE_LIMIT_PER_MINUTE=10

# Port for the dependency-free SMS backend (server/src/smsServer.mjs).
SMS_PORT=3001
